{
  "name": "pixora",
  "private": true,
  "version": "1.1.3",
  "description": "Pixora – Screen Capture Studio: premium screenshot & screen recorder Chrome extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:pages": "vite build",
    "build:content": "node scripts/build-content.mjs",
    "build": "npm run typecheck && npm run build:pages && npm run build:content && node scripts/copy-ocr-assets.mjs && node scripts/verify-package.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/changa-one": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/crafty-girls": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/frijole": "^5.3.0",
    "@fontsource/griffy": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/spirax": "^5.3.0",
    "lucide-react": "^1.72.0",
    "mediabunny": "^1.65.2",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^25.0.1",
    "typescript": "~5.9",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
